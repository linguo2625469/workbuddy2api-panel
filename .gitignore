# Auth & secrets
auths/
data/
*.key
*.pem
*.env
.env
.env.*

# Binaries (anchored to repo root only — bare "login"/"credit" would also ignore cmd/login/, cmd/credit/)
/login
/credit
/wb2api
/signin_bin

# Config with secrets (use config.example.json)
config.json

# Build artifacts
*.tmp
__pycache__/

# 前端构建（node_modules 不进库；dist 构建产物提交进库，保证 go build 开箱即用）
internal/panel/frontend/node_modules/
npm-debug.log*

# Backups (contains auth tokens)
backups/

# IDE
.idea/
.vscode/
LOOP.md
PLAN.md
SPEC.md
docs/

# 设计/计划文档（但 README.md 必须进版本库）
*.md
!README.md

# Windows binaries
/wb2api.exe
/login.exe
/credit.exe

# Release / 本地交叉编译产物（GitHub Actions 自动打包，见 .github/workflows/release.yml）
/wb2api-*
/wb2api-smoke
/wb2api-smoke.exe
/dist-release/

# 本地验证工具（判据逆向过程脚本，结论沉淀于 data/desktop-task-protocol.md）
/cmd/desktopverify*/
*.zip
*.tar.gz
server.exe
